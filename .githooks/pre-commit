#!/bin/sh
# Pre-commit: golangci-lint on packages that have staged .go files;
# findings cancel the commit. The whole package (directory), not individual
# files: golangci-lint over a subset of files builds an isolated package and
# spews phantom undefined errors for symbols from non-staged neighbors
# (helpers of neighboring *_test.go).
# Findings are scoped by --new-from-rev=HEAD — only this commit's lines.
# Activation: make hooks (git config core.hooksPath .githooks).
# Deliberate bypass: git commit --no-verify.

set -eu

# skip merge commits: their new lines are code from another branch
if [ -e "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then
	exit 0
fi

names=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACM -- '*.go') || exit 0
if [ -z "$names" ]; then
	exit 0
fi

echo "▶ pre-commit: golangci-lint on packages with staged Go files..."

# package directories of staged files, no duplicates
dirs=$(printf '%s\n' "$names" | while IFS= read -r f; do dirname "$f"; done | sort -u)

# into positional parameters — to survive spaces in paths
set --
while IFS= read -r d; do
	set -- "$@" "$d"
done <<EOF
$dirs
EOF

new_rev=HEAD
if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
	# first commit in the repository: compare against the empty tree
	new_rev=4b825dc642cb6eb9a060e54bf8d69288fbee4904
fi

# Without --fix (as in CI): autofix patches the working tree, not the index —
# the commit would go through with unfixed code. To fix locally: make lint.
if ! go tool golangci-lint run \
	--new-from-rev="$new_rev" \
	--config=.golangci.yaml \
	--max-issues-per-linter=1000 \
	--max-same-issues=1000 \
	"$@"; then
	echo >&2 ""
	echo "✖ pre-commit: lint found problems — commit cancelled." >&2
	echo "  Fix them (make lint), stage the fixes, and commit again," >&2
	echo "  or bypass deliberately: git commit --no-verify" >&2
	exit 1
fi

echo "✔ pre-commit: lint passed"
